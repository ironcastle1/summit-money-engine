PORT=3000
MERLIN_DB_PATH=./data/merlin.sqlite
MERLIN_UPLOAD_DIR=./data/uploads
MERLIN_PREVIEW_DIR=./data/previews
MERLIN_PRODUCT_DIR=./data/products
MERLIN_PUBLIC_DIR=./public

# Required for Ask MERLIN and automatic live market research.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_RESEARCH_MODEL=gpt-5.6-sol

# Automatic evidence research. Set false to disable.
MERLIN_AUTO_RESEARCH=true
MERLIN_RESEARCH_INTERVAL_HOURS=12

MERLIN_AUTOMATION_TOKEN=change-me
MERLIN_ALLOWED_ORIGINS=http://localhost:3000
MERLIN_API_BASE_URL=

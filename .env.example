GOOGLE_CIVIC_BASE_URL=https://www.googleapis.com/civicinfo/v2
INTELLIGENCE_REFRESH_MS=300000
INTELLIGENCE_STALE_MS=3600000

# Accounts / sessions / persistence
ALLOW_REGISTRATION=true
SESSION_SECRET=

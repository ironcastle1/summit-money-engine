# MERLIN V20 core runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=4173
LOG_LEVEL=info
PUBLIC_ORIGIN=http://localhost:4173
SESSION_SECRET=development-only-change-this-before-production
SECURE_COOKIES=false
ALLOW_REGISTRATION=true
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_DISPLAY_NAME=Owner

# Runtime resilience
HTTP_TIMEOUT_MS=12000
SOURCE_REFRESH_MS=120000
SOURCE_STALE_MS=900000
RATE_LIMIT_PER_MINUTE=240
REQUEST_TIMEOUT_MS=30000
RUNTIME_SAMPLE_MS=10000
SLOW_REQUEST_MS=1000
MAX_EVENT_LOOP_P95_MS=250
ALLOWED_ORIGINS=

# Map
MAP_TILES_ENABLED=true
MAP_STYLE_URL=/api/map/tiles/streets/{z}/{x}/{y}.png
MAP_TILE_TIMEOUT_MS=8000
MAP_TILE_MAX_ZOOM=19

# Optional intelligence connectors
ACLED_ACCESS_TOKEN=
X_BEARER_TOKEN=
COINGECKO_API_KEY=
ALPHA_VANTAGE_API_KEY=
GOOGLE_CIVIC_API_KEY=
COMTRADE_SUBSCRIPTION_KEY=
EIA_API_KEY=
PORTWATCH_BASE_URL=

# Optional billing connectors
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_PRO=
PAYPAL_PLAN_TEAM=
COINBASE_BUSINESS_BEARER_TOKEN=
COINBASE_API_KEY_ID=
COINBASE_API_KEY_SECRET=
COINBASE_WEBHOOK_SECRET=

# Public-first live-data platform. Core feeds work without API keys.
LIVE_DATA_ENABLED=true
LIVE_DATA_AUTO_START=true
LIVE_DATA_REFRESH_MS=120000
LIVE_DATA_TIMEOUT_MS=15000
LIVE_DATA_CONCURRENCY=4
LIVE_DATA_MARINE_PORT_LIMIT=5
LIVE_DATA_FILE=runtime-data/live-data.json
LIVE_DATA_COUNTRIES=GB,US,CN,DE,FR,IN,JP,BR,SA,AE,TR,RU,EG,ZA,AU
ECB_FX_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml
UN_SANCTIONS_URL=https://scsanctions.un.org/resources/xml/en/consolidated.xml
PORTWATCH_CATALOG_URL=https://portwatch.imf.org/api/search/v1
COINBASE_PUBLIC_BASE_URL=https://api.exchange.coinbase.com
BINANCE_PUBLIC_BASE_URL=https://api.binance.com

# ReliefWeb now requires a pre-approved appname. Leave blank until approved.
RELIEFWEB_APP_NAME=
RELIEFWEB_DISASTERS_ENABLED=false

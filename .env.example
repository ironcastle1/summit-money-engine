PORT=3000
MERLIN_DB_PATH=./data/merlin.sqlite
MERLIN_PUBLIC_DIR=./public
MERLIN_ALLOWED_ORIGINS=
MERLIN_LOCAL_AI_URL=http://127.0.0.1:11434
MERLIN_LOCAL_AI_MODEL=merlin-cnc
MERLIN_LOCAL_AI_TIMEOUT_MS=180000
MERLIN_AUTO_RESEARCH=true
MERLIN_RESEARCH_INTERVAL_HOURS=12
MERLIN_RESEARCH_MAX_RESULTS=8
MERLIN_RESEARCH_FETCH_PAGES=true
MERLIN_RESEARCH_USER_AGENT=MERLIN-CNC-Research/4.0

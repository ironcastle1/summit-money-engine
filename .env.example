PORT=3000
MERLIN_DB_PATH=./data/merlin.sqlite
MERLIN_PUBLIC_DIR=./public
MERLIN_ALLOWED_ORIGINS=
MERLIN_AUTO_RESEARCH=true
MERLIN_RESEARCH_INTERVAL_HOURS=12
MERLIN_RESEARCH_MAX_RESULTS=8
MERLIN_RESEARCH_QUERIES_PER_SCAN=30
MERLIN_RESEARCH_ENRICH_PER_QUERY=2
MERLIN_RESEARCH_FETCH_PAGES=true
MERLIN_RESEARCH_USER_AGENT=MERLIN-CNC-Research/7.0
MERLIN_REQUIRE_AUTOMATION_TOKEN=false
MERLIN_AUTOMATION_TOKEN=

# Optional public-data enrichment for Business Outreach.
# Nominatim asks high-volume users to identify themselves; use a real contact email if you use outreach scanning heavily.
MERLIN_NOMINATIM_EMAIL=
MERLIN_OVERPASS_URL=https://overpass-api.de/api/interpreter
COMPANIES_HOUSE_API_KEY=

# Optional direct store APIs. CSV import works without any of these.
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_SHOP_ID=
ETSY_ACCESS_TOKEN=
EBAY_ACCESS_TOKEN=
EBAY_MARKETPLACE_ID=EBAY_GB

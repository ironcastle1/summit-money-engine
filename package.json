{
  "name": "merlin-world-map",
  "version": "7.0.0",
  "private": true,
  "type": "module",
  "description": "Public-source geopolitical and market signal platform with a dark-blue high-detail map and toggleable operational overlays.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-reporter=spec tests/*.test.js",
    "verify": "node scripts/verify.js",
    "browser:test": "python3 scripts/browser-test.py",
    "lines": "node scripts/line-count.js",
    "package:release": "python3 scripts/package-release.py"
  },
  "dependencies": {
    "maplibre-gl": "6.2.0"
  }
}

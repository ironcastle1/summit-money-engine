{
  "name": "merlin-cnc",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "description": "MERLIN - product-centred CNC business operating system with deterministic intake, short product IDs, unified inventory, DXF analysis and market collectors",
  "engines": {
    "node": "20.19.5"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/preflight.js",
    "seed": "node scripts/seed-current-business.js",
    "start:windows": "powershell -ExecutionPolicy Bypass -File scripts/start-merlin.ps1"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "dxf-parser": "^1.1.2",
    "express": "^5.1.0",
    "multer": "^1.4.5-lts.1"
  }
}
